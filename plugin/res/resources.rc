#include "resource.h"
#include <windows.h>

IDI_ICON_7Z ICON "7z.ico"

STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
{
    IDS_VERSION, 	VER_STR
}

IDD_ABOUT DIALOG 0, 0, 140, 115
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About 7z Plugin"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
FONT 9, "Segoe UI"
{
    CONTROL "OK", 1, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 45, 95, 50, 14
    CONTROL "(c) 2026 MasterZ", -1, STATIC, SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 25, 56, 90, 8
    CONTROL "7z Archive Extraction Plugin", -1, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 10, 7, 120, 80
    CONTROL "Version %s", IDC_VERSION, STATIC, SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 25, 19, 90, 8
    CONTROL IDI_ICON_7Z, -1, STATIC, SS_ICON | WS_CHILD | WS_VISIBLE, 60, 34, 20, 20
    CONTROL "Author: oiramario", -1, STATIC, SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 25, 74, 90, 8
}


1 VERSIONINFO
FILEVERSION 1,0,30,0
PRODUCTVERSION 1,0,30,0
FILEOS 0x40004
FILETYPE 0x2
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0"
        {
            VALUE "CompanyName", "ACD Systems, Ltd."
            VALUE "FileDescription", "ID_7Z"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "ID_7Z"
            VALUE "LegalCopyright", "Copyright \xA9 2013 ACD Systems, Ltd."
            VALUE "OriginalFilename", "ID_7Z.apl"
            VALUE "ProductName", "ID_7Z"
            VALUE "ProductVersion", VER_STR
        }
    }

    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x0409 0x04B0
    }
}
